{{!
    @template mod_coassemble/embed

    Shared course and collection iframe with an accessible status region.

    Context variables required for this template:
    * url - Signed iframe URL
    * title - Accessible iframe title
    * allow - Browser permission policy
    * shellclass - Optional layout modifier
    * resolve - Whether to render the recovery form
    * resolveurl, cmid, sesskey - Recovery form fields

    Example context (json):
    {
        "url": "https://example.com/embed",
        "title": "Coassemble course",
        "allow": "fullscreen",
        "shellclass": "coassemble-embed-shell--view",
        "resolve": false
    }
}}
<div id="coassemble-session-status" class="coassemble-session-status" role="status" aria-live="polite" aria-atomic="true"></div>
<div class="coassemble-embed-shell {{shellclass}}">
    <iframe id="coassemble-embed-frame" src="{{url}}" class="coassemble-embed-iframe"
        allow="{{allow}}" allowfullscreen title="{{title}}"></iframe>
</div>
{{#resolve}}
<form id="coassemble-resolve-form" method="post" action="{{resolveurl}}" hidden>
    <input type="hidden" name="id" value="{{cmid}}">
    <input type="hidden" name="resolve" value="1">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
</form>
{{/resolve}}
