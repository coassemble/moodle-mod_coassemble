{{!
    @template mod_coassemble/launch

    Submit the saved initial creation flow.

    Context variables required for this template:
    * url - Launch URL
    * cmid - Course module id
    * flow - Saved creation flow
    * sesskey - CSRF token

    Example context (json):
    {"url":"/mod/coassemble/view.php","cmid":2,"flow":"ai","sesskey":"example"}
}}
<form id="coassemble-launch-form" method="post" action="{{url}}">
    <input type="hidden" name="id" value="{{cmid}}">
    <input type="hidden" name="mode" value="edit">
    <input type="hidden" name="flow" value="{{flow}}">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <button type="submit" class="btn btn-primary">{{#str}}continue{{/str}}</button>
</form>
