{{!
    @template mod_coassemble/toolbar

    Activity navigation and creation flows.

    Context variables required for this template:
    * label - Accessible navigation label
    * links - Navigation links containing url, label and optional primary/current/exit
    * post, sesskey - Optional POST form fields on a link
    * class - Optional toolbar class
    * coursename, activityname - Optional Moodle-formatted context labels

    Example context (json):
    {
        "label": "Coassemble activity",
        "class": "coassemble-player-chrome",
        "links": [{"url": "#", "label": "Back to course", "exit": true}]
    }
}}
<nav class="coassemble-toolbar {{class}}" aria-label="{{label}}">
    {{#coursename}}
    <div class="coassemble-course-context">
        <span class="coassemble-course-name">{{{coursename}}}</span>
        <span aria-hidden="true"> / </span>
        <span class="coassemble-activity-name">{{{activityname}}}</span>
    </div>
    {{/coursename}}
    {{#links}}
    {{#post}}
    <form method="post" action="{{url}}">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <button type="submit" class="btn {{#primary}}btn-primary{{/primary}}{{^primary}}btn-secondary{{/primary}}">{{label}}</button>
    </form>
    {{/post}}
    {{^post}}
    <a href="{{url}}" class="btn {{#exit}}btn-link coassemble-exit-authoring{{/exit}}{{^exit}}{{#primary}}btn-primary{{/primary}}{{^primary}}btn-secondary{{/primary}}{{/exit}}"{{#current}} aria-current="true"{{/current}}>{{label}}</a>
    {{/post}}
    {{/links}}
</nav>
