{{!
    @template mod_coassemble/back_link

    Return to the activity or course.

    Context variables required for this template:
    * url - Return URL
    * label - Link text

    Example context (json):
    {"url":"#","label":"Back to course"}
}}
<p class="coassemble-library-back"><a href="{{url}}" class="btn btn-link">{{label}}</a></p>
