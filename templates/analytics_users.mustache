{{!
    @template mod_coassemble/analytics_users

    Enrolled-user analytics picker. User data is escaped by Mustache.

    Context variables required for this template:
    * users - User rows containing name, email and url

    Example context (json):
    {
        "users": [{"name": "Sam Student", "email": "sam@example.com", "url": "#"}]
    }
}}
<table class="generaltable">
    <caption>{{#str}} analytics_pick_user, mod_coassemble {{/str}}</caption>
    <thead><tr>
        <th scope="col">{{#str}} fullname {{/str}}</th>
        <th scope="col">{{#str}} email {{/str}}</th>
        <th scope="col">{{#str}} nav_analytics, mod_coassemble {{/str}}</th>
    </tr></thead>
    <tbody>
        {{#users}}
        <tr>
            <th scope="row">{{name}}</th>
            <td>{{email}}</td>
            <td><a href="{{url}}" class="btn btn-secondary btn-sm">{{#str}} analytics_user, mod_coassemble {{/str}}<span class="accesshide">: {{name}}</span></a></td>
        </tr>
        {{/users}}
    </tbody>
</table>
